/*########################################
		NULL Functions
  ########################################

  What is NULL?
  NULL means nothing, unknown!

  NULL is not equal to anything
	- NULL is NOT zero
	- NULL is NOT an empty string
	- NULL is NOT blank space

* ISNULL()
	Replaces 'NULL' with a specific value
	Syntax:
		ISNULL(value, replacement_value)

* COALESCE()
	Returns the first non-null value from a list
	Syntax:
		COALESCE(value1, value2, value3,...)

--------------------------------------------------
	Handling NULLs
--------------------------------------------------
### in Data Aggregation ###

Find the average score of the customers*/

SELECT 
	CustomerID,
	Score,
	COALESCE(Score,0),
	AVG(Score) OVER()  Avg_Score,  -- What is OVER()? It puts the average on EVERY ROW. No GROUP BY needed.
	AVG(COALESCE(Score,0)) OVER() Coal_Avg_Score
FROM Sales.Customers


-- ### Mathematical Operations ###

-- Display the full name of customers in a single field
-- by merging their first and last names, and add 10 bonus points to each customer's score.

SELECT
	CustomerID,
	COALESCE(FirstName,' ') + ' ' + COALESCE(LastName,' ') FullName,
	Score,
	COALESCE(Score,0) + 10 ScoreAfterBonus
FROM Sales.Customers

-- ### Sorting Data ###
-- Sort the customers from lowest to highest score, with nulls appearing last

SELECT
	CustomerID,
	Score
FROM Sales.Customers
ORDER BY CASE WHEN Score IS NULL THEN 1 ELSE 0 END, Score --This Case/When is a way to force the nulls to appear last
