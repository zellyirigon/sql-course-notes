-- DDL- Data Definition Language (CREATE, ALTER, DROP)

/* Create a new table called persons with columns: id, person_name,
birth_date, and phone.*/

CREATE TABLE persons(
	id INT NOT NULL,
	person_name NVARCHAR(50) NOT NULL,
	birth_date DATE NOT NULL,
	phone NVARCHAR(15) NOT NULL
	CONSTRAINT pk_persons PRIMARY KEY (id) --definition of the primary key.
);
--  Add a new column called email to the persons table 
-- Alter adds the column to the end of the table
ALTER TABLE persons 
ADD email NVARCHAR(50) NOT NULL;
SELECT * FROM persons;

--Remove the column phone from the persons table
ALTER TABLE persons 
DROP COLUMN phone;

--To remove the table and data inside it
--Delete the table persons from the database
DROP TABLE persons;
